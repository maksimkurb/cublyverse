# Production settings of the Compose stack.
#
#   cp .env.example .env    (inside deploy/) and fill in every value marked here.
#   chmod 600 .env
#
# Compose reads this file for the ${VARIABLE} substitutions of
# docker-compose.yml; the list of variables the application itself understands
# is in docs/DEPLOY.md and ../.env.example. Never commit the real file.

# --- PostgreSQL -------------------------------------------------------------
# The password is generated, not chosen:
#   openssl rand -base64 32
POSTGRES_DB=cublyverse
POSTGRES_USER=cublyverse
POSTGRES_PASSWORD=
# Creates checksums in the data directory, catching silent corruption.
# postgres:17 reads this only while initialising an empty volume.
POSTGRES_INITDB_ARGS=--data-checksums

# --- Application ------------------------------------------------------------
# Release tag of the built image. "latest" is fine for the example; on a server
# pin the version you tested.
CUBLYVERSE_TAG=latest
# Local port the reverse proxy forwards to. Do not expose it to the internet.
APP_PORT=8080
# Public HTTPS address without a trailing slash. Required: Telegram Mini App
# buttons and OIDC callbacks only work over HTTPS.
PUBLIC_BASE_URL=https://cublyverse.example.com

# --- OIDC (SSO sign-in) -----------------------------------------------------
# Register PUBLIC_BASE_URL/auth/callback as the redirect URI at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: absolute callback if it differs from PUBLIC_BASE_URL/auth/callback.
OIDC_REDIRECT_URL=

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. It is both the transport credential and the HMAC key
# that verifies Mini App initData, so it must belong to the bot that opens the
# WebApp. An example of the shape only: 123456:TEST
TELEGRAM_BOT_TOKEN=

# --- Matrix (optional) ------------------------------------------------------
MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_PASSWORD=
MATRIX_PICKLE_KEY=

# --- Runtime tuning ---------------------------------------------------------
BOT_HANDLER_TIMEOUT=30s
REMINDERS_TICK_INTERVAL=15s

# --- Backups (deploy/backup.sh) ---------------------------------------------
# Directory the cron job of docs/DEPLOY.md writes dumps to.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
