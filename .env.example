# Cublyverse configuration.
#
# Copy this file to .env for local development (`cp .env.example .env`).
# The values below are placeholders; never commit real secrets.
#
# Only DATABASE_URL is required to start the server. Unset messenger
# variables simply disable the corresponding transport.

# --- HTTP -------------------------------------------------------------------
# Address the server listens on.
HTTP_ADDR=:8080
# Public base URL used in links sent to messengers (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
# text | json
LOG_FORMAT=text

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgres://cublyverse:cublyverse@localhost:5432/cublyverse?sslmode=disable

# --- OIDC (M1) --------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Matrix -----------------------------------------------------------------
MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_PASSWORD=
# SQLite file with the end-to-end encryption state.
MATRIX_CRYPTO_DB=matrix-crypto.db
MATRIX_PICKLE_KEY=
