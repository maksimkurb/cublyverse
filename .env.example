# Cublyverse configuration.
#
# Copy this file to .env for local development (`cp .env.example .env`).
# The values below are placeholders; never commit real secrets.
#
# Only DATABASE_URL is required to start the server. Unset messenger
# variables simply disable the corresponding transport. The bot additionally
# needs OIDC, because an account without a binding could not sign in.

# --- HTTP -------------------------------------------------------------------
# Address the server listens on.
HTTP_ADDR=:8080
# Public base URL used in links sent to messengers and to decide whether the
# session cookie is Secure (https required). No trailing slash.
PUBLIC_BASE_URL=http://localhost:8080
# text | json
LOG_FORMAT=text

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgres://cublyverse:cublyverse@localhost:5432/cublyverse?sslmode=disable

# --- OIDC (M1) --------------------------------------------------------------
# SSO sign-in: the account is the source of truth for a user. All four values
# are needed for sign-in; without OIDC_ISSUER the API runs but sign-in and the
# messenger transports are disabled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Absolute callback URL registered at the provider. Derived as
# PUBLIC_BASE_URL + /auth/callback when empty.
OIDC_REDIRECT_URL=

# --- Telegram ---------------------------------------------------------------
# Bot token. It is also the HMAC key that verifies Mini App initData, so the
# value must be the token of the same bot that opens the WebApp.
TELEGRAM_BOT_TOKEN=

# --- Matrix -----------------------------------------------------------------
MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_PASSWORD=
# SQLite file with the end-to-end encryption state.
MATRIX_CRYPTO_DB=matrix-crypto.db
MATRIX_PICKLE_KEY=
